# FREQ. environment variable names only.
# Never commit real values. Configure these in Vercel project settings.

# Optional — leave unset for the first vertical slice.
# The experience runs fully from authored local content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do not prefix with NEXT_PUBLIC.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional public site URL for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
