# Environment variable names only.
# Never commit real values. Configure these in Vercel project settings.

# Optional public site URL for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional durable memory. Leave unset: the Next.js backend still runs,
# and collective counts live in process memory.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Reserved public names. The browser does not talk to Supabase in this slice.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
